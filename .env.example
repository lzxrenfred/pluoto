# Public browser credentials only. Never put a service-role key in this file.
# Without these values Pluoto uses its labeled same-device password fallback
# and local realtime Plane store. Local passwords are stored only as salted verifiers.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Public HTTPS address used in friend invitation links and QR codes.
# Leave unset for localhost development; the UI will clearly label links as local-only.
NEXT_PUBLIC_APP_ORIGIN=https://YOUR-PRODUCTION-DOMAIN.example
